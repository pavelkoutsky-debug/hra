{
  "name": "ucednikova-noc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Učedníkova noc — AI textová adventura z rudolfínské Prahy",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vitest run test/smoke.live.test.ts --config vitest.smoke.config.ts",
    "art": "node scripts/process-art.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1"
  },
  "devDependencies": {
    "sharp": "^0.35.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
